{
  "name": "opendrop",
  "version": "0.1.0",
  "description": "Open-source installation helper for Steam Frame",
  "author": "Cuteminded",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist/main/index.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "dev:demo": "electron-vite dev -- --demo",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:ui": "node scripts/smoke.mjs",
    "test:interface": "node scripts/interface.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "package": "npm run build && electron-builder --publish never"
  },
  "dependencies": {
    "bonjour-service": "1.4.4",
    "ssh2": "1.17.0",
    "yauzl": "3.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ssh2": "^1.15.5",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^6.1.1",
    "daisyui": "^5.7.43",
    "electron": "44.4.3",
    "electron-builder": "26.15.3",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.47.0",
    "prettier": "^3.9.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
